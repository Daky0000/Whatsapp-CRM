# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_crm
PORT=8080
PUBLIC_URL=https://whatsappcrm.dakyx.com
# 32+ random bytes, used to sign session cookies.
SESSION_SECRET=
# 32 bytes as 64 hex chars, used to encrypt stored WhatsApp tokens. `openssl rand -hex 32`
ENCRYPTION_KEY=

# ============================================================================
# SHARED WITH DAKYXTECH OS: same names, same values. On Railway, put these in
# the project's Shared Variables (or reference the OS service: ${{OS.SMTP_HOST}})
# so they live in one place. The OS reads environment variables before its own
# settings table, so it keeps working when the values move here.
# ============================================================================

# --- Paystack (the OS's account) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_TEST_SECRET_KEY=
# live | test
PAYSTACK_MODE=test
# NOT shared: the OS's PAYSTACK_CALLBACK_URL points at os.dakyx.com. This app returns buyers to PUBLIC_URL/billing.
# Optional: existing Paystack plan codes. Created automatically on first checkout when empty.
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_PRO=

# --- Meta / WhatsApp Cloud API ---
META_APP_ID=
META_APP_SECRET=
# Embedded Signup configuration id (Facebook Login for Business → Configurations).
META_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# What one marketing template costs us, in pesewas, including our margin. Check Meta's rate card.
WA_MARKETING_PESEWAS=40

# --- AI (the OS's Anthropic key) ---
ANTHROPIC_API_KEY=
AI_TRIAGE_MODEL=claude-opus-5-5
AI_DRAFT_MODEL=claude-opus-5-5

# --- Voice notes (Pro): speech-to-text ---
# deepgram (default) | openai
TRANSCRIBE_PROVIDER=deepgram
TRANSCRIBE_API_KEY=
# Optional: an OpenAI-compatible Whisper server you host.
TRANSCRIBE_BASE_URL=

# --- Email (the OS's mailbox): password-reset links and the morning summary ---
# SMTP | HOSTINGER. Unset: whichever below is configured, SMTP first.
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
HOSTINGER_MAIL_TOKEN=
HOSTINGER_MAILBOX_ID=
HOSTINGER_MAILBOX_ADDRESS=
MAIL_FROM_NAME=DakyX
MAIL_FROM_EMAIL=
MAIL_REPLY_TO=

# --- WhatsApp sign-up codes, from the OS's own WhatsApp Business number ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Not in the OS yet: an approved AUTHENTICATION template (copy-code button) on that number.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en

# ============================================================================
# SHARED WITH LALUXURY (nobleenclave.com): Vynfy, for SMS and voice-call codes
# ============================================================================
VYNFY_API_KEY=
# Must exactly match a sender ID Vynfy approved (max 11 characters). Register "DakyX" with Vynfy;
# laluxury's "NobleEnclav" would show the shop's name to WhatsApp CRM customers.
VYNFY_SENDER_ID=DakyX
